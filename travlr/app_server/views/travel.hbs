<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Travel | Travlr Getaways</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>
	<div id="background">
		<div id="page">

			{{> header }}

			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Travel</h1>
                            {{#if message}}<p role="status">{{message}}</p>{{/if}}

							<ul id="sites">
								{{#each trips}}
									<li>
										<a href="/api/trips/{{code}}">
											<img src="/images/{{image}}" alt="{{name}}">
										</a>

										<h2>
											<a href="/travel">{{name}}</a>
										</h2>

										<p>
											{{description}}
                                            <br>{{resort}} &mdash; {{length}}
                                            <br>Starts {{start}} &mdash; ${{perPerson}} per person
										</p>
									</li>
								{{/each}}
							</ul>

						</div>
					</div>
				</div>
			</div>

		</div>

		{{> footer }}

	</div>
</body>
</html>